# Export these variables in the shell that starts the worker; no real secrets.
CONTROL_PLANE_URL=http://127.0.0.1:8000
WORKER_ID=W-001
WORKER_TOKEN=replace-with-the-worker-specific-token
MAX_CONTAINERS=4
MAX_CPU_CORES=2
MAX_RAM_GB=4
MAX_STORAGE_GB=16
DEPLOYMENT_STORAGE_GB=1
HEARTBEAT_INTERVAL=5
RECONNECT_MIN_SECONDS=1
RECONNECT_MAX_SECONDS=30
DOCKER_TIMEOUT=60
IMAGE_PULL_POLICY=always
DISCONNECT_GRACE_SECONDS=10
STOP_ON_DISCONNECT=false
BIND_ADDRESS=127.0.0.1
CONTAINER_USER=65532:65532
# Optional: short, private, stable path; do not place it in the repository.
# STATE_DIR=/Users/your-user/.local/share/lattice/worker
# Full snapshots automatically use /api/workers/{worker_id}/snapshot.
REQUIRE_CONTROL_PLANE_LEASE=true
MAX_LEASE_SECONDS=60
MAX_CLOCK_SKEW_SECONDS=2
# Integrated commands carry Box storage_limit_gb. Local fallback overrides:
# DEPLOYMENT_STORAGE_LIMITS='{"00000000-0000-0000-0000-000000000001":2.0}'
