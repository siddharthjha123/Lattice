# Server-only controller target. Never put an admin token in NEXT_PUBLIC_*.
CONTROL_PLANE_URL=http://127.0.0.1:8000

# Public origin reached by spare laptops (may tunnel to the same local controller).
NEXT_PUBLIC_WORKER_SERVER=http://127.0.0.1:8000

# To use the existing public controller for dashboard requests instead:
# CONTROL_PLANE_URL=http://127.0.0.1:8000
