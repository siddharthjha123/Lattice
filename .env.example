# Copy to .env, supply fresh random values, and export explicitly before Python.
# This file contains placeholders, not working credentials.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URLSAFE_VALUE
DATABASE_URL=postgresql+psycopg://lattice:REPLACE_WITH_SAME_POSTGRES_PASSWORD@127.0.0.1:5432/lattice
SECRET_KEY=REPLACE_WITH_RANDOM_HASHING_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_MANAGEMENT_SECRET_AT_LEAST_32_CHARACTERS
REGISTRY_URL=127.0.0.1:5050
PUBLIC_BASE_URL=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000
# JSON lists must be shell-quoted when this file is sourced.
ALLOWED_REPOSITORY_HOSTS='["github.com"]'
CORS_ORIGINS='[]'
ALLOW_LOCAL_REPOSITORIES=false
AUTO_MIGRATE=false

# Public production profile (keep local defaults above for compose development):
# DATABASE_CA_FILE=/absolute/path/to/ca.pem
DATABASE_DIRECT_DNS=false
# Optional app-only HTTPS DNS when native/port-53 DNS is unreliable.
# Sends the database hostname to Cloudflare 1.1.1.1; preserves DB TLS verification.
DATABASE_DNS_OVER_HTTPS=false
ALLOWED_HOSTS='["localhost","127.0.0.1","testserver"]'
EXPOSE_API_DOCS=true
# Public deployment uses EXPOSE_API_DOCS=false and its exact API host/origins.

# Selected remote registry; enable only after credentials and push/pull checks.
# REGISTRY_URL=ghcr.io/siddharthjha123
# REGISTRY_USERNAME=siddharthjha123
# REGISTRY_PASSWORD=REPLACE_WITH_PRIVATE_CLASSIC_PAT_WITH_WRITE_PACKAGES

# Optional pool/CLI release settings (absolute existing directory on controller):
# WORKER_RELEASE_DIR=/absolute/path/to/distributions
# Enable only after wildcard DNS/tunnel configuration:
# APP_DOMAIN=example.com
